{
  "name": "pastel-board",
  "version": "1.0.0",
  "private": true,
  "description": "Tablero Kanban con HTML5, CSS3, JS Vanilla, SortableJS y json-server",
  "scripts": {
    "api": "node server.js",
    "web": "serve -l 5173 .",
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:api\" \"npm:web\"",
    "start": "npm run dev"
  },
  "devDependencies": {
